{
  "name": "satellite-control-center",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.satellite.control",
    "productName": "Спутник-ЦУП",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "../../modules/**/*",
      "../../web-dashboard/**/*",
      "../../ecosystem.config.js",
      "../../package.json"
    ],
    "extraResources": [
      {
        "from": "../../modules",
        "to": "modules"
      },
      {
        "from": "../../web-dashboard",
        "to": "web-dashboard"
      },
      {
        "from": "../../ecosystem.config.js",
        "to": "ecosystem.config.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Спутник-ЦУП-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Спутник-ЦУП"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.0"
  }
}